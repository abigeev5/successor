# Скопируйте в .env и поправьте. В репозиторий .env не попадает.
# DATABASE_URL и STORAGE_DIR для docker compose задаются в docker-compose.yml.

# --- Порты и пароль БД (docker compose) ---
POSTGRES_PASSWORD=preemnik
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Локальный запуск backend без docker (make dev-backend) ---
DATABASE_URL=postgresql+psycopg://preemnik:preemnik@localhost:5432/preemnik
STORAGE_DIR=./data

# --- Безопасность ---
# Обязательно смените вне демо-стенда: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_TTL_HOURS=12
COOKIE_SECURE=false          # true, если стенд работает по HTTPS
DEMO_MODE=true               # баннер «Демо-режим» и подсказка демо-учёток на входе

# --- LLM ---
# Сейчас реализован только fake (M0). openai_compatible появится в M1, gigachat — по решению команды.
LLM_PROVIDER=fake            # openai_compatible | gigachat | fake
LLM_BASE_URL=http://llm:8000/v1
LLM_API_KEY=
LLM_MODEL=                   # например, модель семейства Qwen или T-lite/T-pro
LLM_JUDGE_MODEL=             # модель для проверки обоснованности; по умолчанию = LLM_MODEL
LLM_TIMEOUT_S=60
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# --- Эмбеддинги (реальные провайдеры — M1/M2) ---
EMBEDDINGS_PROVIDER=fake     # sentence_transformers | openai_compatible | fake
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_BASE_URL=
EMBEDDINGS_DEVICE=cpu
EMBEDDINGS_DIM=1024

# --- Распознавание речи (реальный провайдер — M1) ---
ASR_PROVIDER=fake            # faster_whisper | gigaam | fake
ASR_MODEL=large-v3
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# --- Зрение (M3) ---
VLM_ENABLED=false
VLM_BASE_URL=
VLM_MODEL=
OCR_ENGINE=fake              # easyocr | tesseract | fake

# --- Приватность ---
OFFLINE_MODE=false           # true: запретить обращения к нелокальным адресам
RETENTION_DAYS_RAW_MEDIA=180

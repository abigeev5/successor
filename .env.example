# Скопируйте в .env и поправьте. В репозиторий .env не попадает.
# DATABASE_URL и STORAGE_DIR для docker compose задаются в docker-compose.yml.

# --- Порты и пароль БД (docker compose) ---
POSTGRES_PASSWORD=preemnik
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Локальный запуск backend без docker (make dev-backend) ---
DATABASE_URL=postgresql+psycopg://preemnik:preemnik@localhost:5432/preemnik
STORAGE_DIR=./data

# --- Безопасность ---
# Обязательно смените вне демо-стенда: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_TTL_HOURS=12
COOKIE_SECURE=false          # true, если стенд работает по HTTPS
DEMO_MODE=true               # баннер «Демо-режим» и подсказка демо-учёток на входе

# --- LLM: llama.cpp `llama-server` на хосте (D-032, D-033; инструкция — README) ---
# fake — без модели: интервьюер задаёт заготовленные вопросы, карточки не извлекаются.
LLM_PROVIDER=fake            # openai_compatible | fake (gigachat — по решению команды)
LLM_BASE_URL=http://host.docker.internal:8080/v1   # без docker: http://localhost:8080/v1
LLM_API_KEY=
LLM_MODEL=                   # llama-server обслуживает одну модель и имя игнорирует
LLM_JUDGE_MODEL=             # модель для проверки обоснованности (M2); по умолчанию = LLM_MODEL
LLM_TIMEOUT_S=60
LLM_JSON_MODE=json_schema    # json_schema | json_object | none (D-034)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# --- Эмбеддинги: второй llama-server с bge-m3 (D-035); нужны для дедупликации и поиска ---
EMBEDDINGS_PROVIDER=fake     # openai_compatible | fake (sentence_transformers — позже)
EMBEDDINGS_MODEL=bge-m3
EMBEDDINGS_BASE_URL=http://host.docker.internal:8081/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_DEVICE=cpu
EMBEDDINGS_DIM=1024

# --- Ассистент: когда отказывать без вызова LLM (D-047); подбираются по отчёту `make eval` ---
RAG_MIN_SIMILARITY=0.45      # лучший косинус вопроса и чанка
RAG_MIN_TEXT_COVERAGE=0.6    # доля слов вопроса, найденных в одном чанке

# --- Распознавание речи: faster-whisper (D-031) ---
# Модель скачивается при первом голосовом ответе (~500 МБ для small) в volume `models`.
# В закрытом контуре укажите в ASR_MODEL путь к заранее скачанной папке модели.
ASR_PROVIDER=fake            # faster_whisper | fake
ASR_MODEL=small
ASR_DOWNLOAD_ROOT=
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# --- Записи экрана: OCR для поиска персональных данных на скриншотах (D-058) ---
# Tesseract (rus+eng) уже есть в образе backend. fake — ничего не распознаёт, ПДн НЕ размываются.
OCR_ENGINE=tesseract         # tesseract | fake
VLM_ENABLED=false            # описание экрана моделью — позже
VLM_BASE_URL=
VLM_MODEL=

# --- Приватность ---
OFFLINE_MODE=false           # true: запретить обращения к нелокальным адресам
RETENTION_DAYS_RAW_MEDIA=180
